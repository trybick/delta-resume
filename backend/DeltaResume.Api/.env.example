ANTHROPIC_API_KEY=
CLERK_FRONTEND_API_URL=
CLERK_SECRET_KEY=
IP_HASH_SALT=
BACKEND_RUNNING_LOCALLY=true

# Optional — defaults to Host=localhost;Database=deltaresume
# DATABASE_URL=Host=localhost;Database=deltaresume

# Comma-separated browser origins allowed to call the API (default: http://localhost:5200).
# CORS_ORIGINS=http://localhost:5200,https://your-frontend.example.com

# Production only (ignored when BACKEND_RUNNING_LOCALLY=true):
# TRUST_FORWARDED_HEADERS=true

# Optional — Sentry DSN for error monitoring (leave unset to disable):
# SENTRY_DSN=
